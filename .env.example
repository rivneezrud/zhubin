# Firebase & Google Cloud Configuration
# Get these values from your Google Cloud Console (GCP)
# https://console.cloud.google.com/

# Google API Key for Firebase (from GCP Console > APIs & Services > Credentials)
# This is the PUBLIC API key used by the Android app for Firebase services
FIREBASE_GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Google Crash Reporting API Key (usually same as above)
# Can be obtained from GCP Console
FIREBASE_GOOGLE_CRASH_REPORTING_API_KEY=YOUR_GOOGLE_CRASH_REPORTING_API_KEY_HERE

# Path to google-services.json (optional, for advanced setups)
# Usually in app/ directory
GOOGLE_SERVICES_JSON_PATH=app/google-services.json

# MapTiler API Key (for location/map features)
ELEMENT_ANDROID_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY_HERE

# PostHog API Key (for analytics in call feature)
ELEMENT_CALL_POSTHOG_API_KEY=YOUR_POSTHOG_API_KEY_HERE

# Sentry DSN (error tracking)
ELEMENT_ANDROID_SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# Add any other API keys or secrets here
# IMPORTANT: Never commit .env files with real values to git!
